# Cadastro e recuperação de senha ainda não existem no backend.
# "true" (default) usa os mocks do frontend; "false" chama a API de verdade.
VITE_MOCK_AUTH=true

# Dataset de F4 e números do dashboard.
# O backend atual só devolve 4 documentos com os status antigos, então o mock
# é o default. Troque para "false" quando a API falar o vocabulário canônico.
VITE_MOCK_API=true

# Assistente da tela de Nova F4.
# Vazio ou qualquer valor != "live": motor de regras local, sem chave nenhuma.
# "live": manda o preenchimento e o histórico para o modelo via /api/chat
# (precisa de GEMINI_API_KEY no backend/.env). Para desligar depois da
# gravação, basta tirar esta linha — nenhum código precisa ser removido.
VITE_AI_ASSISTANT=
