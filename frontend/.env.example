# Cadastro e recuperação de senha ainda não existem no backend.
# "true" (default) usa os mocks do frontend; "false" chama a API de verdade.
VITE_MOCK_AUTH=true

# Dataset de F4 e números do dashboard.
# O backend atual só devolve 4 documentos com os status antigos, então o mock
# é o default. Troque para "false" quando a API falar o vocabulário canônico.
VITE_MOCK_API=true
